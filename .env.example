# Skopiuj do .env i dostosuj w razie potrzeby: cp .env.example .env

# PostgreSQL
POSTGRES_DB=netsim
POSTGRES_USER=netsim
POSTGRES_PASSWORD=netsim
POSTGRES_PORT=5432

# Porty aplikacji (na hoscie)
API_PORT=5080
WEB_PORT=5173

# Srodowisko backendu (Development wlacza OpenAPI/Scalar)
ASPNETCORE_ENVIRONMENT=Development

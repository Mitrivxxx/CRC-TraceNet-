<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NetSim.Api</RootNamespace>
    <AssemblyName>NetSim.Api</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Wlacza generowanie pliku XML z komentarzami - trafiaja one do OpenAPI/Swagger. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Nie wymuszaj komentarzy XML na kazdym publicznym elemencie. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.*" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.*" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetSim.ServiceDefaults\NetSim.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
